{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Temperature by State in Malaysia",
    "fontSize": 20,
    "anchor": "middle",
    "offset": 20
  },
  "width": 1000,
  "height": 500,
  "params": [
    {
      "name": "temp_selection",
      "value": 24,
      "bind": {
        "input": "range", "min": 24, "max": 30, "step": 0.5, "name": "Min Temperature: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": [109.5, 4.2],
    "scale": 2600
  },
  "layer": [
    {
      "name": "Ocean",
      "data": {
        "url": "chloropleth_map/js/ne_10m.json",
        "format": {"type": "topojson", "feature": "ne_10m_ocean"}
      },
      "mark": {"type": "geoshape", "fill": "#dae8f5"}
    },
    {
      "name": "Graticules",
      "data": {
        "url": "chloropleth_map/js/ne_10m.json",
        "format": {"type": "topojson", "feature": "ne_10m_graticules_10"}
      },
      "mark": {"type": "geoshape", "filled": false, "stroke": "white", "strokeWidth": 0.3}
    },
    {
      "name": "Background_States",
      "data": {
        "url": "chloropleth_map/js/ne_10m.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "mark": {"type": "geoshape", "fill": "#efefef", "stroke": "white", "strokeWidth": 0.5}
    },
    {
      "name": "Temperature_Map",
      "data": {
        "url": "chloropleth_map/js/ne_10m.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "data/full_weather.csv"},
            "key": "state",
            "fields": ["temperature"]
          }
        },
        {"filter": "datum.temperature >= temp_selection"}
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 0.5},
      "encoding": {
        "color": {
          "field": "temperature",
          "type": "quantitative",
          "scale": {"scheme": "reds"}
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "State"},
          {"field": "temperature", "type": "quantitative", "title": "Temp (°C)"}
        ]
      }
    },
    {
      "name": "State_Labels",
      "data": {
        "url": "chloropleth_map/js/ne_10m.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "mark": {"type": "text", "fontSize": 10, "fontWeight": "bold", "dy": -5},
      "encoding": {
        "longitude": {"field": "properties.longitude", "type": "quantitative"},
        "latitude": {"field": "properties.latitude", "type": "quantitative"},
        "text": {"field": "properties.name", "type": "nominal"},
        "opacity": {
          "condition": {
            "test": "datum.properties.name == 'Selangor' || datum.properties.name == 'Sarawak' || datum.properties.name == 'Sabah' || datum.properties.name == 'Johor' || datum.properties.name == 'Kedah' || datum.properties.name == 'Kelantan' || datum.properties.name == 'Melaka' || datum.properties.name == 'Negeri Sembilan' || datum.properties.name == 'Pahang' || datum.properties.name == 'Perak' || datum.properties.name == 'Perlis' || datum.properties.name == 'Pulau Pinang' || datum.properties.name == 'Terengganu' || datum.properties.name == 'W.P. Kuala Lumpur' || datum.properties.name == 'W.P. Labuan' || datum.properties.name == 'W.P. Putrajaya'",
            "value": 1
          },
          "value": 0
        }
      }
    }
  ]
}