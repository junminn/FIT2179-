{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Average Temperature by State in Malaysia",
  "width": "container",
  "height": 600,
  "projection": {
    "type": "mercator",
    "center": [109.5, 4.2],
    "scale": 3200
  },
  "layer": [
    {
      "data": {
        "url": "ne_10m_admin_1_states_provinces.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "../../data/full_weather.csv"
            },
            "key": "state",
            "fields": ["temperature"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "temperature",
          "type": "quantitative",
          "scale": {"scheme": "reds"},
          "title": "Temp (°C)"
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "State"},
          {"field": "temperature", "type": "quantitative", "title": "Temp (°C)", "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "url": "ne_10m_admin_1_states_provinces.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "mark": {
        "type": "text",
        "fontSize": 8,
        "fontWeight": "bold",
        "baseline": "middle",
        "dy": -5
      },
      "encoding": {
        "longitude": {"field": "properties.longitude", "type": "quantitative"},
        "latitude": {"field": "properties.latitude", "type": "quantitative"},
        "text": {"field": "properties.name", "type": "nominal"},
        "color": {"value": "black"},
        "opacity": {
          "condition": {
            "test": "datum.properties.name == 'Selangor' || datum.properties.name == 'Sarawak' || datum.properties.name == 'Sabah' || datum.properties.name == 'Kedah'",
            "value": 1
          },
          "value": 0.6
        }
      }
    }
  ]
}