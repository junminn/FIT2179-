{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Average Temperature by State in Malaysia",
  "width": 600,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [102.5, 4.2],
    "scale": 1700
  },
  "data": {
    "url": "ne_10m_admin_1_states_provinces.json",
    "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
  },
  "transform": [
    {
      "lookup": "properties.name",
      "from": {
        "data": {"url": "full_weather.csv"},
        "key": "state",
        "fields": ["temperature"]
      }
    }
  ],
  "mark": {"type": "geoshape", "stroke": "white"},
  "encoding": {
    "color": {
      "field": "temperature",
      "type": "quantitative",
      "scale": {"scheme": "reds"},
      "title": "Temp (°C)"
    },
    "tooltip": [
      {"field": "properties.name", "type": "nominal", "title": "State"},
      {"field": "temperature", "type": "quantitative", "title": "Temperature", "format": ".1f"}
    ]
  }
}