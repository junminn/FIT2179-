{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Average Temperature by State in Malaysia",
  "width": "container",
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [102.5, 4.2],
    "scale": 1700
  },
  "layer": [
    {
      "data": {
        "url": "ne_10m_admin_1_states_provinces.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "full_weather.csv"},
            "key": "state",
            "fields": ["temperature"]
          }
        },
        {
          "calculate": "datum.temperature",
          "as": "Temp"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "Temp",
          "type": "quantitative",
          "scale": {"scheme": "reds"},
          "title": "Temp (°C)"
        },
        "tooltip": [
          {"field": "properties.name", "type": "nominal", "title": "State"},
          {"field": "Temp", "type": "quantitative", "title": "Temperature", "format": ".1f"}
        ]
      }
    },
    {
      "data": {
        "url": "ne_10m_admin_1_states_provinces.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_1_states_provinces"}
      },
      "mark": {
        "type": "text", 
        "fontSize": 8, 
        "fontWeight": "bold",
        "interactive": false
      },
      "encoding": {
        "longitude": {"field": "properties.longitude", "type": "quantitative"},
        "latitude": {"field": "properties.latitude", "type": "quantitative"},
        "text": {"field": "properties.name", "type": "nominal"},
        "opacity": {
          "condition": {
            "test": "datum.properties.name == 'Kuala Lumpur' || datum.properties.name == 'Putrajaya' || datum.properties.name == 'Labuan'",
            "value": 0
          },
          "value": 1
        }
      }
    }
  ]
}