{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Average Temperature by State in Malaysia",
  "width": 600,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [101.9758, 4.2105],
    "scale": 1500
  },
  "layer": [
    {
      "data": {
        "url": "malaysia.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"},
      "encoding": {"tooltip": null}
    },
    {
      "data": {
        "url": "malaysia.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_0_countries"}
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://github.com/junminn/FIT2179-/raw/refs/heads/main/chloropleth_map/full_weather.csv"
            },
            "key": "state",
            "fields": ["temperature"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
        "field": "temperature",
        "type": "quantitative",
        "scale": {"scheme": "reds"}
      },
      "tooltip": [
      {"field": "properties.NAME", "type": "nominal", "title": "Try NAME"},
      {"field": "properties.STATE", "type": "nominal", "title": "Try STATE"},
      {"field": "id", "type": "nominal", "title": "Try ID"}
    ]
  }
    }
  ]
}