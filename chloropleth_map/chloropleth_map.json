{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Average Temperature by State in Malaysia",
  "width": 600,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [109.5, 4.2],
    "scale": 1500
  },
  "layer": [
    {
      "data": {
        "url": "https://github.com/junminn/FIT2179-/raw/refs/heads/main/chloropleth_map/malaysia.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_0_countries"}
      },
      "mark": {"type": "geoshape", "fill": "lightgray", "stroke": "white"},
      "encoding": {"tooltip": null}
    },
    {
      "data": {
        "url": "https://github.com/junminn/FIT2179-/raw/refs/heads/main/chloropleth_map/malaysia.json",
        "format": {"type": "topojson", "feature": "ne_10m_admin_0_countries"}
      },
      "transform": [
        {
          "lookup": "properties.NAME",
          "from": {
            "data": {
              "url": "https://github.com/junminn/FIT2179-/raw/refs/heads/main/chloropleth_map/full_weather.csv"
            },
            "key": "state",
            "fields": ["temperature"]
          }
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white"},
      "encoding": {
        "color": {
          "field": "temperature",
          "aggregate": "mean",
          "type": "quantitative",
          "scale": {"scheme": "reds"},
          "title": "Temp (°C)"
        },
        "tooltip": [
          {"field": "properties.NAME", "type": "nominal", "title": "State"},
          {"field": "temperature", "aggregate": "mean", "type": "quantitative", "format": ".1f", "title": "Avg Temp"}
        ]
      }
    }
  ]
}