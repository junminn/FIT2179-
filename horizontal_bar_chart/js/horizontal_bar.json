{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Top 10 Hottest States in Malaysia",
    "fontSize": 18,
    "anchor": "start",
    "color": "#2c3e50"
  },
  "width": 900,
  "height": 400,
  "data": {
    "url": "data/full_weather.csv",
    "format": {"type": "csv", "parse": {"temperature": "number"}}
  },
  "transform": [
    {
      "aggregate": [{"op": "mean", "field": "temperature", "as": "avg_temp"}],
      "groupby": ["state"]
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "avg_temp", "order": "descending"}]
    },
    {"filter": "datum.rank <= 10"}
  ],
  "layer": [
    {
      "description": "LAYER 1: Your original Bar Chart",
      "mark": {"type": "bar", "cornerRadiusEnd": 4},
      "encoding": {
        "x": {
          "field": "avg_temp",
          "type": "quantitative",
          "title": "Average Temperature (°C)",
          "scale": {"zero": false}
        },
        "y": {
          "field": "state",
          "type": "nominal",
          "title": "State",
          "sort": {"field": "avg_temp", "order": "descending"}
        },
        "color": {
          "condition": {
            "test": "datum.rank <= 2",
            "value": "#e74c3c"
          },
          "value": "#bdc3c7"
        },
        "tooltip": [
          {"field": "state", "type": "nominal"},
          {"field": "avg_temp", "type": "quantitative", "title": "Avg Temp", "format": ".1f"}
        ]
      }
    },
    {
      "description": "LAYER 2: Text Annotation & Arrow Pointer",
      "data": {
        "values": [
          {
            "x_start": 29.5,
            "y_start": "Kelantan",
            "x_end": 28.7,
            "y_end": "Kelantan",
            "text": "Coming in 2nd hottest!"
          },
          {
            "x_start": 29.5,
            "y_start": "Perlis",
            "x_end": 28.8,
            "y_end": "Perlis",
            "text": "Hottest State!"
          }
        ]
      },
      "layer": [
        {
          "description": "Draws the text box label",
          "mark": {
            "type": "text",
            "align": "left",
            "baseline": "middle",
            "dx": 5,
            "fontSize": 12,
            "fontStyle": "italic",
            "color": "#2c3e50"
          },
          "encoding": {
            "x": {"field": "x_start", "type": "quantitative"},
            "y": {"field": "y_start", "type": "nominal", "sort": {"field": "avg_temp", "order": "descending"}},
            "text": {"field": "text", "type": "nominal"}
          }
        },
        {
          "description": "Draws the pointer arrow line",
          "mark": {
            "type": "rule",
            "color": "#333",
            "strokeWidth": 1.5,
            "shape": "arrow"
          },
          "encoding": {
            "x": {"field": "x_start", "type": "quantitative"},
            "y": {"field": "y_start", "type": "nominal", "sort": {"field": "avg_temp", "order": "descending"}},
            "x2": {"field": "x_end"},
            "y2": {"field": "y_end"}
          }
        }
      ]
    }
  ]
}