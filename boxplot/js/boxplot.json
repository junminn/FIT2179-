{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/full_weather.csv"},
  "params": [
    {
      "name": "Threshold",
      "value": 29,
      "bind": {
        "input": "range",
        "min": 26,
        "max": 35,
        "step": 0.5,
        "name": "Heat Alert (°C): "
      }
    }
  ],
  "facet": {
    "row": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "header": {"labelAngle": 0, "labelAlign": "left", "labelFontSize": 11, "labelFontWeight": "bold"}
    }
  },
  "spec": {
    "width": 1000,
    "height": 60,
    "transform": [
      {
        "density": "temperature",
        "groupby": ["state"],
        "extent": [24, 35],
        "steps": 100
      },
      {
        "calculate": "datum.value >= Threshold ? 'Alert' : 'Normal'",
        "as": "Status"
      }
    ],
    "mark": {
      "type": "area",
      "stroke": "white",
      "strokeWidth": 0.8,
      "opacity": 0.8,
      "interpolate": "monotone"
    },
    "encoding": {
      "x": {
        "field": "value",
        "type": "quantitative",
        "title": "Temperature (°C)",
        "scale": {"domain": [24, 38]}
      },
      "y": {
        "field": "density",
        "type": "quantitative",
        "scale": {"range": [60, 0]},
        "axis": null
      },
      "color": {
        "field": "Status",
        "type": "nominal",
        "scale": {
          "domain": ["Normal", "Alert"],
          "range": ["#3498db", "#e74c3c"]
        },
        "legend": null
      },
      "tooltip": [
        {"field": "state", "title": "State"},
        {"field": "value", "title": "Temp", "format": ".1f"}
      ]
    }
  },
  "config": {
    "facet": {"spacing": -30},
    "view": {"stroke": null}
  }
}