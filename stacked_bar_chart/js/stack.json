{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Warning Distribution by Label and Pollutant Type (Vertical)",
  "width": 950,
  "height": 400,
  "data": {
    "url": "data/air_quality_warning.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "label",
      "type": "nominal",
      "sort": [
        "Good",
        "Moderate",
        "Unhealthy for sensitive groups",
        "Unhealthy",
        "Very Unhealthy",
        "Hazardous"
      ],
      "title": "Air Quality Label",
      "axis": {
        "labelAngle": -45
      }
    },
    "y": {
      "aggregate": "count",
      "type": "quantitative",
      "title": "Number of Pollutants"
    },
    "color": {
      "field": "pollutant",
      "type": "nominal",
      "scale": {
        "domain": [
          "CO", 
          "CO2", 
          "NO2", 
          "O3", 
          "PM10", 
          "PM2.5", 
          "SO2", 
          "Unidentified", 
          "multi-pollutant"
        ],
        "range": [
          "#0072B2", 
          "#E69F00", 
          "#56B4E9", 
          "#009E73", 
          "#F0E442", 
          "#CC79A7", 
          "#D55E00", 
          "#999999", 
          "#000000"
        ]
      },
      "title": "Pollutant Type"
    },
    "tooltip": [
      {"field": "label", "type": "nominal"},
      {"field": "pollutant", "type": "nominal"},
      {"field": "warning_message", "type": "nominal"},
      {"field": "should_report", "type": "nominal"}
    ]
  }
}