{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "UV Level by Exposure Category",
  "width": 1100,
  "height": 400,
  "data": {
    "url": "data/uv_info.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "exposure_category",
      "type": "nominal",
      "title": "Exposure Category"
    },
    "y": {
      "field": "uv_level",
      "type": "quantitative",
      "title": "UV Level"
    },
    "color": {
      "field": "exposure_category",
      "type": "nominal",
      "scale": {
        "range": [
          "#1155ad", 
          "#8c13a1", 
          "#f1c40f", 
          "#e67e22", 
          "#2ecc71"
        ]
      },
      "legend": null
    },
    "tooltip": [
      {
        "field": "uv_level",
        "type": "quantitative",
        "title": "UV Level"
      },
      {
        "field": "exposure_category",
        "type": "nominal",
        "title": "Exposure Category"
      },
      {
        "field": "short_description",
        "type": "nominal",
        "title": "Safety"
      }
    ]
  }
}