{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/uv_info.csv"
  },
  "mark": {
    "type": "arc", 
    "innerRadius": 70, 
    "stroke": "#fff",
    "cursor": "pointer"
  },
  "encoding": {
    "theta": {
      "field": "uv_level", 
      "type": "quantitative", 
      "stack": true
    },
    "color": {
      "field": "exposure_category",
      "type": "nominal",
      "title": "Exposure Risk",
      "scale": {
        "domain": ["low", "moderate", "high", "very high", "extreme"],
        "range": ["#2ecc71", "#f1c40f", "#e67e22", "#e74c3c", "#8e44ad"]
      },
      "legend": {
        "orient": "right",
        "titleFontSize": 12,
        "labelFontSize": 11
      }
    },
    "tooltip": [
      {"field": "exposure_category", "type": "nominal", "title": "Category"},
      {"field": "uv_level", "type": "quantitative", "title": "UV Index Threshold"},
      {"field": "short_description", "type": "nominal", "title": "Advice"},
      {"field": "long_description", "type": "nominal", "title": "Health Impact"}
    ]
  },
  "view": {"stroke": null}
}