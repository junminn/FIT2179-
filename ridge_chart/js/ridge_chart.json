{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/full_weather.csv"},
  "padding": {
    "top": 10,
    "left": 10,
    "bottom": 10,
    "right": 10
  },
  "params": [
    {
      "name": "Threshold",
      "value": 26,
      "bind": {
        "input": "range",
        "min": 26,
        "max": 32,
        "step": 0.5,
        "name": "Heat Alert (°C): "
      }
    }
  ],
  "facet": {
    "row": {
      "field": "state",
      "type": "nominal",
      "title": null,
      "header": {"labelAngle": 0, "labelAlign": "left", "labelFontSize": 11, "labelFontWeight": "bold"}
    }
  },
  "spec": {
    "width": 950,
    "height": 90,
    "transform": [
      {
        "density": "temperature",
        "groupby": ["state"],
        "extent": [24, 32],
        "steps": 100
      },
      {
        "calculate": "datum.value >= Threshold ? 'Alert' : 'Normal'",
        "as": "Status"
      }
    ],
    "mark": {
      "type": "area",
      "stroke": "grey",
      "strokeWidth": 1,
      "opacity": 0.8,
      "interpolate": "monotone"
    },
    "encoding": {
      "x": {
        "field": "value",
        "type": "quantitative",
        "title": "Temperature (°C)",
        "scale": {"domain": [24, 32]}
      },
      "y": {
        "field": "density",
        "type": "quantitative",
        "scale": {"range": [90, 0]}, 
        "axis": null
      },
      "color": {
        "field": "Status",
        "type": "nominal",
        "scale": {
          "domain": ["Normal", "Alert"],
          "range": ["#3498db", "#e74c3c"]
        },
        "legend": null
      }
    }
  },
  "config": {
    "facet": {"spacing": -65}, 
    "view": {"stroke": null}
  }
}