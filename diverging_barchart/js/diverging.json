{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {"url": "data/air_quality_warning.csv"},
  "width":600,
  "height": 300,
  "transform": [
    {
      "calculate": "{'Good': 0, 'Moderate': 1, 'Unhealthy for sensitive groups': 2, 'Unhealthy': 3, 'Very Unhealthy': 4, 'Hazardous': 5}[datum.label]",
      "as": "severity_score"
    },
    {
      "calculate": "datum.severity_score - 1.5",
      "as": "deviation"
    }
  ],
  "mark": {"type": "bar", "cornerRadiusEnd": 4},
  "encoding": {
    "y": {
      "field": "pollutant",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelFontSize": 12,
        "labelPadding": 20, 
        "offset": 10,
        "ticks": false,
        "domain": false
      }
    },
    "x": {
      "field": "deviation",
      "type": "quantitative",
      "title": "Risk Level (Safe ← | → Danger)",
      "axis": {
        "values": [-1.5, 0, 1.5, 3.5],
        "grid": true,
        "domain": true
      }
    },
    "color": {
      "field": "label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Good",
          "Moderate",
          "Unhealthy for sensitive groups",
          "Unhealthy",
          "Very Unhealthy",
          "Hazardous"
        ],
        "range": ["#2ecc71", "#f1c40f", "#e67e22", "#e74c3c", "#9b59b6", "#8e44ad"]
      },
      "legend": {"orient": "bottom", "title": null}
    },
    "tooltip": [
      {"field": "pollutant", "title": "Pollutant"},
      {"field": "label", "title": "Risk Category"},
      {"field": "warning_message", "title": "Advice"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"domainColor": "#ddd"}
  }
}